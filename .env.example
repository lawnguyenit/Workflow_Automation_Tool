# Local dev only. Copy to .env (git-ignored) and replace the two REQUIRED values. Never commit a real .env.

# REQUIRED. URL-safe password for the local Postgres (also used by n8n).
POSTGRES_PASSWORD=replace-with-a-local-only-url-safe-password
# REQUIRED. >= 32 random chars. Encrypts credentials stored in n8n. Back it up; losing or changing it makes stored credentials unreadable.
N8N_ENCRYPTION_KEY=replace-with-a-random-key-at-least-32-characters

# Optional n8n settings (defaults shown).
GENERIC_TIMEZONE=Asia/Saigon
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
# Set to true when n8n is served over HTTPS.
N8N_SECURE_COOKIE=false
# Hours of execution history to keep (336 = 14 days).
EXECUTIONS_DATA_MAX_AGE=336

# Variables below were used by the old Python `api` service and the legacy lead/document workflows.
# They are kept so existing workflows keep their configuration; the architecture branch decides which survive.
WORKFLOW_API_KEY=
GOOGLE_FORM_SPREADSHEET_ID=
GOOGLE_FORM_SHEET_ID=
GHL_LOCATION_ID=
GHL_PRIVATE_INTEGRATION_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# REAL lead qualification stays disabled until this explicit UTC-day request cap is set.
LEAD_LLM_MAX_CALLS_PER_DAY=
# Stable high-entropy secret of at least 32 random bytes; protect a backup and do not rotate without state reconciliation.
FOLLOWUP_IDENTITY_HMAC_KEY=
