# Local demo only. Replace these values before starting Compose; never commit a real .env.
POSTGRES_PASSWORD=replace-with-a-local-only-url-safe-password
N8N_ENCRYPTION_KEY=replace-with-a-random-key-at-least-32-characters
WORKFLOW_API_KEY=
GOOGLE_FORM_SPREADSHEET_ID=
GOOGLE_FORM_SHEET_ID=
N8N_IMAGE=n8nio/n8n:stable
GHL_LOCATION_ID=
GHL_PRIVATE_INTEGRATION_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# REAL lead qualification stays disabled until this explicit UTC-day request cap is set.
LEAD_LLM_MAX_CALLS_PER_DAY=
# Generate a stable high-entropy secret of at least 32 random bytes; protect a backup and do not rotate without state reconciliation.
FOLLOWUP_IDENTITY_HMAC_KEY=
