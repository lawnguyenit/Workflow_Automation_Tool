    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{ json: { form_id: 'REPLACE_WITH_PRIVATE_GOOGLE_FORM_ID', lease_owner_id: String($execution.id || 'manual-preview'), run_mode: 'DRY_RUN' } }];"
      },
      "id": "992d61d8-045a-444b-87e4-9183aee7126a",
      "name": "Read cursor and form config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        460
      ]
    },
    {
      "parameters": {
        "url": "={{ 'https://forms.googleapis.com/v1/forms/' + $('Read cursor and form config').first().json.form_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "options": {
          "timeout": 30000
        }
      },
      "id": "7b322dc0-b7f0-4f12-920a-8e73d91b7fb8",
      "name": "Read Form question schema",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        920,
        460
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "parameters": {
        "url": "={{ 'https://forms.googleapis.com/v1/forms/' + $('Read cursor and form config').first().json.form_id + '/responses?pageSize=500' + ($('Acquire source poll lease').first().json.business_result.cursor_at ? '&filter=' + encodeURIComponent('timestamp >= ' + $('Acquire source poll lease').first().json.business_result.cursor_at) : '') }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "options": {
          "timeout": 30000,
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "type": "qs",
                    "name": "pageToken",
                    "value": "={{ $response.body.nextPageToken }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body.nextPageToken }}",
              "limitPagesFetched": true,
              "maxRequests": 20,
              "requestInterval": 250
            }
          }
        }
      },
      "id": "886df706-b82d-43cc-b3bc-5b5c3af7b8a4",
      "name": "List Form responses",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1160,
        460
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const pages = $('List Form responses').all().map(item => item.json);\nif (!pages.length) return [{ json: { no_responses: true } }];\nconst finalPage = pages[pages.length - 1];\nif (finalPage.nextPageToken) throw new Error('Google Forms response page cap reached; cursor was not advanced. Increase the bounded page cap or reconcile backlog.');\nconst responses = pages.flatMap(page => Array.isArray(page.responses) ? page.responses : []);\nif (!responses.length) return [{ json: { no_responses: true } }];\nconst form = $('Read Form question schema').first().json;\nconst config = $('Read cursor and form config').first().json;\nreturn responses.map(response => {\n  const rawTime = response.lastSubmittedTime || response.createTime;\n  const milliseconds = Date.parse(rawTime || '');\n  if (!response.responseId || !Number.isFinite(milliseconds)) throw new Error('Form response is missing a stable responseId or valid timestamp.');\n  return { json: { form_id: config.form_id, form, response, response_time_ms: milliseconds, run_mode: config.run_mode } };\n});"
      },
      "id": "3f5056c6-6951-420e-83b7-27f636a06ed8",
      "name": "Prepare response events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1840,
        460
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "4dd8e945-7ce9-4cfd-b72e-eae1f9206752",
              "leftValue": "={{ $json.no_responses === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e76a286e-cc4b-4f47-a3f8-191e3f421927",
      "name": "No new responses?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2060,
        460
      ]
    },
    {
      "parameters": {},
      "id": "8c43602b-7a70-4e2f-91a6-a8e26fd3ef08",
      "name": "No new responses",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        2500,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/v1/workflow-instances/portfolio.lead_management_google_forms_api/runs",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { payload: { form_id: $json.form_id, form: $json.form, response: $json.response }, context: { workflow_id: 'lead_management_google_forms_api', attempt: 1, mode: $json.run_mode } } }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "67198120-7eb0-4b85-8cd1-68a0748e3f64",
      "name": "Run local lead workflow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2280,
        620
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const results = $input.all().map(item => item.json);\\nconst sourceEvents = $('Prepare response events').all().map(item => item.json);\\nif (results.length !== sourceEvents.length) throw new Error('Not every fetched response has a workflow result; cursor remains unchanged.');\\nfor (const result of results) {\\n  const state = result?.steps?.store?.business_result?.state;\\n  if (!['STORED', 'DUPLICATE', 'PREVIEWED'].includes(state)) throw new Error('At least one response did not reach an accepted storage state; cursor remains unchanged.');\\n}\\nconst maxMilliseconds = Math.max(...sourceEvents.map(event => event.response_time_ms));\\nconst acquired = $('Acquire source poll lease').first().json.business_result;\\nconst config = $('Read cursor and form config').first().json;\\nreturn [{ json: { payload: { operation: 'commit', checkpoint_key: config.form_id, lease_owner_id: config.lease_owner_id, lease_token: acquired.lease_token || '00000000-0000-4000-8000-000000000000', cursor_at: new Date(maxMilliseconds).toISOString() }, context: { workflow_id: 'google_forms_poll', attempt: 1, mode: config.run_mode } } }];"
      },
      "id": "9b3a9467-04ae-4118-9130-cc32783506de",
      "name": "Prepare checkpoint commit",
