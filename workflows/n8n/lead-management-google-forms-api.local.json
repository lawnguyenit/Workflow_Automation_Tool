        "jsonBody": "={{ { payload: { operation: 'acquire', checkpoint_key: $('Read cursor and form config').first().json.form_id, lease_owner_id: $('Read cursor and form config').first().json.lease_owner_id }, context: { workflow_id: 'google_forms_poll', attempt: 1, mode: $('Read cursor and form config').first().json.run_mode } } }}",
        "options": {
