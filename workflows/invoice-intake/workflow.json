      "name": "Attach duplicate result to PDF",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        0
      ],
      "parameters": {
        "jsCode": "\n// Plumbing only: the sub-workflow returns new items; put provenance + hash back (from the\n// Crypto node) and the PDF binary back (from the split node: the Crypto node drops binary).\nreturn $input.all().map((item, i) => {\n  const hashed = $('Hash PDF bytes (SHA-256)').itemMatching(i);\n  const split = $('Split one item per PDF attachment').itemMatching(i);\n  return { json: { ...hashed.json, ...item.json }, binary: split.binary, pairedItem: { item: i } };\n});"
      }
    },
