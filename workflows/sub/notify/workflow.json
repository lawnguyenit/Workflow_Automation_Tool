{
  "name": "sub: notify",
  "description": "Sub-workflow: send one plain-text notification email about an invoice outcome.",
  "tags": [],
  "settings": {
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": "@workflow:error handler",
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": false
  },
  "nodes": [
    {
      "id": "ab4fe0c1-aa8a-50cb-8f96-60e0200b5882",
      "name": "Compose notification text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "\nconst SUBJECTS = {\n  STORED: 'Invoice stored',\n  CONFLICT: 'Invoice conflict: same email/PDF, different extracted data',\n  REVIEW_REQUIRED: 'Invoice needs manual review',\n};\nreturn $input.all().map((item) => {\n  const j = item.json;\n  const issues = Array.isArray(j.issues) ? j.issues.map((i) => (typeof i === 'string' ? i : i && i.code)).filter(Boolean) : [];\n  const lines = [\n    `Status: ${j.status}`,\n    `File: ${j.filename ?? '-'}`,\n    `Invoice number: ${j.invoice_number ?? '-'}`,\n    `Sender: ${j.sender ?? '-'}`,\n    `Amount: ${j.amount ?? '-'} ${j.currency ?? ''}`.trim(),\n    `Stored row id: ${j.invoice_id ?? '-'}`,\n  ];\n  if (issues.length) lines.push(`Issues: ${[...new Set(issues)].join(', ')}`);\n  lines.push('', `n8n execution: ${$execution.id}`);\n  return { json: { notify_to: j.notify_to, subject: SUBJECTS[j.status] ?? `Invoice: ${j.status}`, body: lines.join('\\n') } };\n});"
      }
    },
    {
      "id": "2066d919-e45e-5cc4-a81f-7dbfe954358b",
      "name": "Note: what this does",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        -300
      ],
      "parameters": {
        "color": 7,
        "content": "## sub: notify\nInput: `status` (STORED|CONFLICT|REVIEW_REQUIRED), `invoice_number`, `sender`, `amount`, `currency`, `invoice_id`, `filename`, `issues` (array).\nOutput: `{ notified, channel, provider_message_id }`.\n\nSends one plain-text email through the \"Gmail (secondary account)\" credential.\nNo email body or attachment content is copied into the message, only the extracted fields and issue codes.\nSet the recipient in **Notification settings**.",
        "height": 280,
        "width": 620
      }
    },
    {
      "id": "9ff381f1-ff12-522a-b221-fb6dc5ed5abc",
      "name": "Notification settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "ff13b7b2-fbed-4856-8884-2658e32eab32",
              "name": "notify_to",
              "type": "string",
              "value": "REPLACE_WITH_RECIPIENT@example.invalid"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "87ae35c1-f73b-52ec-814b-c892e9793b43",
      "name": "Return notification result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        880,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b646ee09-c57e-482e-85c0-9e60aa321925",
              "name": "notified",
              "type": "boolean",
              "value": true
            },
            {
              "id": "2f95ec80-7e0f-4aa4-8000-4a6f07fd3290",
              "name": "channel",
              "type": "string",
              "value": "gmail"
            },
            {
              "id": "15ae7b3c-7112-43bf-84d3-00468356eb6a",
              "name": "provider_message_id",
              "type": "string",
              "value": "={{ $json.id }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "99f172f0-ef16-5038-9e7b-ab3a663aad3a",
      "name": "Send notification email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        660,
        0
      ],
      "parameters": {
        "emailType": "text",
        "message": "={{ $json.body }}",
        "options": {
          "appendAttribution": false
        },
        "sendTo": "={{ $json.notify_to }}",
        "subject": "={{ $json.subject }}"
      },
      "credentials": {
        "gmailOAuth2": {
          "name": "Gmail (secondary account)"
        }
      }
    },
    {
      "id": "5c697f3b-6457-56e8-8ad1-fc3274bcae13",
      "name": "When called by another workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "status",
              "type": "string"
            },
            {
              "name": "invoice_number",
              "type": "string"
            },
            {
              "name": "sender",
              "type": "string"
            },
            {
              "name": "amount",
              "type": "string"
            },
            {
              "name": "currency",
              "type": "string"
            },
            {
              "name": "invoice_id",
              "type": "string"
            },
            {
              "name": "filename",
              "type": "string"
            },
            {
              "name": "issues",
              "type": "array"
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "Compose notification text": {
      "main": [
        [
          {
            "index": 0,
            "node": "Send notification email",
            "type": "main"
          }
        ]
      ]
    },
    "Notification settings": {
      "main": [
        [
          {
            "index": 0,
            "node": "Compose notification text",
            "type": "main"
          }
        ]
      ]
    },
    "Send notification email": {
      "main": [
        [
          {
            "index": 0,
            "node": "Return notification result",
            "type": "main"
          }
        ]
      ]
    },
    "When called by another workflow": {
      "main": [
        [
          {
            "index": 0,
            "node": "Notification settings",
            "type": "main"
          }
        ]
      ]
    }
  }
}
