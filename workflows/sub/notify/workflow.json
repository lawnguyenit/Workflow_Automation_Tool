    {
      "parameters": {
        "jsCode": "\nconst SUBJECTS = {\n  STORED: 'Invoice stored',\n  CONFLICT: 'Invoice conflict: same email/PDF, different extracted data',\n  REVIEW_REQUIRED: 'Invoice needs manual review',\n};\nreturn $input.all().map((item) => {\n  const j = item.json;\n  const issues = Array.isArray(j.issues) ? j.issues.map((i) => (typeof i === 'string' ? i : i && i.code)).filter(Boolean) : [];\n  const lines = [\n    `Status: ${j.status}`,\n    `File: ${j.filename ?? '-'}`,\n    `Invoice number: ${j.invoice_number ?? '-'}`,\n    `Sender: ${j.sender ?? '-'}`,\n    `Amount: ${j.amount ?? '-'} ${j.currency ?? ''}`.trim(),\n    `Stored row id: ${j.invoice_id ?? '-'}`,\n  ];\n  if (issues.length) lines.push(`Issues: ${[...new Set(issues)].join(', ')}`);\n  lines.push('', `n8n execution: ${$execution.id}`);\n  return { json: { notify_to: j.notify_to, subject: SUBJECTS[j.status] ?? `Invoice: ${j.status}`, body: lines.join('\\n') } };\n});"
      },
